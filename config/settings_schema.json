        "label": "Texte",
        "default": "#eef3ff"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texte secondaire",
        "default": "#9dabca"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur principale (boutons, bordures)",
