<section class="ag-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_divider %} ag-section--line{% endif %}" style="--ag-pt: {{ section.settings.padding_top }}px; --ag-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'agency-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    -%}

    <ul class="ag-grid ag-grid--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ag-reveal" style="--ag-i: {{ forloop.index0 | modulo: 3 }};" {{ block.shopify_attributes }}>
          <figure class="ag-card ag-quote">
            {%- if block.settings.is_placeholder and section.settings.placeholder_label != blank -%}
              <span class="ag-demo-tag">{{ section.settings.placeholder_label | escape }}</span>
            {%- else -%}
              {%- render 'agency-icon', icon: 'quote', class: 'ag-quote__mark' -%}
            {%- endif -%}
            <blockquote>{{ block.settings.quote }}</blockquote>
            <figcaption>
              <span class="ag-quote__avatar">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 176
                    | image_tag: width: 44, height: 44, loading: 'lazy', alt: block.settings.author
                  }}
                {%- else -%}
                  <span aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
                {%- endif -%}
              </span>
              <span>
                <span class="ag-quote__name">{{ block.settings.author | escape }}</span>
                {%- if block.settings.role != blank -%}
                  <span class="ag-quote__role">{{ block.settings.role | escape }}</span>
                {%- endif -%}
              </span>
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Agency testimonials",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What clients say."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder tag",
      "default": "Demo placeholder",
      "info": "Shown on testimonials marked as placeholders so visitors never mistake them for real reviews."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_placeholder",
          "label": "This is a placeholder",
          "default": true,
          "info": "Uncheck once you have replaced the text with a genuine client testimonial."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Replace this text with a genuine client testimonial.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Client name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role and company",
          "default": "Role, Company"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Agency testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
