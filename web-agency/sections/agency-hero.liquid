{%- liquid
  assign has_media = false
  if section.settings.show_artwork or section.settings.image != blank
    assign has_media = true
  endif
  assign meta_items = section.settings.meta | newline_to_br | split: '<br />'
-%}
<section class="ag-section ag-hero color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_divider %} ag-section--line{% endif %}" style="--ag-pt: {{ section.settings.padding_top }}px; --ag-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ag-hero__bg" aria-hidden="true"></div>
  <div class="page-width">
    <div class="ag-hero__grid{% if has_media %} ag-hero__grid--media{% endif %}">
      <div class="ag-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ag-eyebrow ag-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ag-display ag-display--{{ section.settings.heading_size }} ag-reveal" style="--ag-i: 1;">
            {{- section.settings.heading -}}
          </h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ag-lead ag-reveal" style="--ag-i: 2;">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="ag-btn-row ag-reveal" style="--ag-i: 3;">
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <a class="ag-btn" href="{{ section.settings.button_link }}">
              {{- section.settings.button_label | escape -}}
              {%- render 'agency-icon', icon: 'arrow', class: 'ag-btn__icon' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
            <a class="ag-btn ag-btn--ghost" href="{{ section.settings.button_link_2 }}">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if has_media -%}
        <div class="ag-hero__media ag-reveal" style="--ag-i: 2;">
          {%- if section.settings.image != blank -%}
            <div class="ag-hero__image">
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag: widths: '375, 550, 750, 1100, 1600', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'eager', fetchpriority: 'high'
              }}
            </div>
          {%- else -%}
            <div class="ag-art" aria-hidden="true">
              <div class="ag-art__glow"></div>
              <div class="ag-art__ring"></div>
              <div class="ag-art__window">
                <div class="ag-art__bar"><i></i><i></i><i></i><span></span></div>
                <div class="ag-art__body">
                  <div class="ag-art__nav"><b></b><span></span><span></span><span></span><em></em></div>
                  <div class="ag-art__headline"><span></span><span></span><span></span></div>
                  <div class="ag-art__copy"><span></span><span></span></div>
                  <div class="ag-art__tiles"><div></div><div></div><div></div></div>
                </div>
              </div>
              <div class="ag-art__code"><span></span><span></span><span></span><span></span><span></span></div>
              <div class="ag-art__phone"><div></div><span></span><span></span><em></em></div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.meta != blank -%}
      <ul class="ag-hero__meta ag-reveal" style="--ag-i: 4;" role="list">
        {%- for item in meta_items -%}
          {%- assign item_text = item | strip -%}
          {%- if item_text != blank -%}
            <li>{{ item_text | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Agency hero",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Web Development Agency"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text is shown in the accent color.",
      "default": "We Build Digital Experiences That Move Businesses Forward."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subtitle",
      "default": "<p>From powerful Shopify stores to custom digital experiences, we design and develop websites that help ambitious brands grow.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Start Your Project"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Explore Our Work"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "checkbox",
      "id": "show_artwork",
      "label": "Show hero artwork",
      "default": true,
      "info": "A built-in illustration is shown until you select an image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (replaces the artwork)"
    },
    {
      "type": "textarea",
      "id": "meta",
      "label": "Highlights row",
      "info": "One item per line. Leave empty to hide.",
      "default": "Shopify Development\nCustom Web Design\nPerformance & SEO\nOngoing Support"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "Agency hero"
    }
  ]
}
{% endschema %}
