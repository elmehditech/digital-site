<section class="ag-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_divider %} ag-section--line{% endif %}" style="--ag-pt: {{ section.settings.padding_top }}px; --ag-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="ag-cta__box ag-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ag-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ag-display ag-display--small">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ag-lead">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="ag-btn-row">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="ag-btn" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
            {%- render 'agency-icon', icon: 'arrow', class: 'ag-btn__icon' -%}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
          <a class="ag-btn ag-btn--ghost" href="{{ section.settings.button_link_2 }}">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.show_whatsapp -%}
          {%- render 'agency-whatsapp', label: section.settings.whatsapp_label -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Agency call to action",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Start a project"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to build something exceptional?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell us about your goals and we will come back with a clear plan, timeline and quote.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Start Your Project"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "default": false,
      "info": "Requires a WhatsApp number in Theme settings > Agency."
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "Agency call to action"
    }
  ]
}
{% endschema %}
