<section class="ag-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_divider %} ag-section--line{% endif %}" style="--ag-pt: {{ section.settings.padding_top }}px; --ag-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'agency-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      layout: section.settings.heading_layout,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    -%}

    <ul class="ag-grid ag-grid--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign delay = forloop.index0 | modulo: section.settings.columns
          assign card_tag = 'div'
          if block.settings.link != blank
            assign card_tag = 'a'
          endif
        -%}
        <li class="ag-reveal" style="--ag-i: {{ delay }};" {{ block.shopify_attributes }}>
          <{{ card_tag }}
            class="ag-card{% if card_tag == 'a' %} ag-card--hover{% endif %}"
            {% if card_tag == 'a' %}
              href="{{ block.settings.link }}"
            {% endif %}
          >
            {%- if section.settings.marker == 'icon' -%}
              <span class="ag-card__icon">{% render 'agency-icon', icon: block.settings.icon %}</span>
            {%- elsif section.settings.marker == 'number' -%}
              <span class="ag-card__index" aria-hidden="true">
                {%- if forloop.index < 10 -%}0{%- endif -%}
                {{- forloop.index -}}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="ag-h3">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ag-text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if card_tag == 'a' and block.settings.link_label != blank -%}
              <span class="ag-card__more">
                {{- block.settings.link_label | escape -}}
                {%- render 'agency-icon', icon: 'arrow', class: 'ag-btn__icon' -%}
              </span>
            {%- endif -%}
          </{{ card_tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Agency cards",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Services"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Everything your brand needs to perform online."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_layout",
      "label": "Heading layout",
      "options": [
        { "value": "split", "label": "Split" },
        { "value": "stack", "label": "Stacked" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "marker",
      "label": "Card marker",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "number", "label": "Number" },
        { "value": "none", "label": "None" }
      ],
      "default": "icon"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "store", "label": "Store" },
            { "value": "cart", "label": "Cart" },
            { "value": "layout", "label": "Layout" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "shield", "label": "Shield" },
            { "value": "code", "label": "Code" },
            { "value": "pen", "label": "Pen" },
            { "value": "search", "label": "Search" },
            { "value": "chat", "label": "Chat" },
            { "value": "layers", "label": "Layers" },
            { "value": "globe", "label": "Globe" },
            { "value": "target", "label": "Target" },
            { "value": "check", "label": "Check" }
          ],
          "default": "layers"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this service, value or strength in one or two sentences.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Agency cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
