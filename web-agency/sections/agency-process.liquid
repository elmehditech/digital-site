<section class="ag-section color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_divider %} ag-section--line{% endif %}" style="--ag-pt: {{ section.settings.padding_top }}px; --ag-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'agency-head',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    -%}

    <ol class="ag-steps" style="--ag-cols: {{ section.blocks.size | at_least: 1 | at_most: 5 }};" role="list">
      {%- for block in section.blocks -%}
        <li class="ag-step ag-reveal" style="--ag-i: {{ forloop.index0 | at_most: 5 }};" {{ block.shopify_attributes }}>
          <span class="ag-step__num" aria-hidden="true">
            {%- if forloop.index < 10 -%}0{%- endif -%}
            {{- forloop.index -}}
          </span>
          <h3 class="ag-h3">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="ag-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Agency process",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Process"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A clear path from idea to launch."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Explain what happens during this step.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Agency process",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
