{%- doc -%}
  Renders an inline line icon used by the agency sections.

  @param {string} icon - Icon name: arrow, store, cart, layout, rocket, refresh, bolt, shield, code, pen, search, chat, layers, globe, target, quote, whatsapp
  @param {string} [class] - Additional CSS classes for the svg element

  @example
  {% render 'agency-icon', icon: 'arrow', class: 'ag-btn__icon' %}
{%- enddoc -%}
{%- if icon == 'whatsapp' -%}
  <svg class="{{ class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24ZM8.53 7.33c-.16 0-.43.06-.66.31-.22.25-.87.86-.87 2.07 0 1.22.89 2.39 1 2.56.14.17 1.76 2.67 4.25 3.73.59.27 1.05.42 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.27-.25-.14-1.47-.74-1.69-.82-.23-.08-.37-.12-.56.12-.16.25-.64.81-.78.97-.15.17-.29.19-.53.07-.26-.13-1.06-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.12-.24-.01-.39.11-.5.11-.11.27-.29.37-.44.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.11-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43-.14 0-.3-.01-.47-.01Z"/></svg>
{%- elsif icon == 'quote' -%}
  <svg class="{{ class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 18.5C4 12.2 7.6 8 13 6.5l.8 2.2c-3 1.2-4.7 3.3-5 5.8H13V24H4v-5.5Zm14 0c0-6.3 3.6-10.5 9-12l.8 2.2c-3 1.2-4.7 3.3-5 5.8H27V24h-9v-5.5Z"/></svg>
{%- else -%}
  <svg class="{{ class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'arrow' -%}
        <path d="M4 12h16M14 6l6 6-6 6"/>
      {%- when 'store' -%}
        <path d="M3.5 9.5 5 4h14l1.5 5.5M4.5 11v9h15v-9M9.5 20v-5h5v5"/><path d="M3.5 9.5a2.8 2.8 0 0 0 5.6 0 2.9 2.9 0 0 0 5.8 0 2.8 2.8 0 0 0 5.6 0"/>
      {%- when 'cart' -%}
        <path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H6.5"/><circle cx="9" cy="19" r="1.3"/><circle cx="17" cy="19" r="1.3"/>
      {%- when 'layout' -%}
        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>
      {%- when 'rocket' -%}
        <path d="M12 15c-1.5-1-2.5-2-3-3 .5-4 3-7.5 8-8.5 0 5-2.5 8.5-5 11.5Z"/><path d="M9 12 5.5 12.5 8 9M12 15l-.5 3.5L15 16M6.5 17.5 5 19"/><circle cx="14.5" cy="9.5" r="1.2"/>
      {%- when 'refresh' -%}
        <path d="M20 12a8 8 0 0 1-14.3 5M4 12a8 8 0 0 1 14.3-5"/><path d="M18.5 3v4h-4M5.5 21v-4h4"/>
      {%- when 'bolt' -%}
        <path d="M13 3 5 13.5h6L10 21l9-11h-6.5L13 3Z"/>
      {%- when 'shield' -%}
        <path d="M12 3 5 5.5v6c0 4.5 3 7.8 7 9.5 4-1.7 7-5 7-9.5v-6L12 3Z"/><path d="m9 12 2.2 2.2L15.5 10"/>
      {%- when 'code' -%}
        <path d="m8.5 8-4.5 4 4.5 4M15.5 8l4.5 4-4.5 4M13.5 5l-3 14"/>
      {%- when 'pen' -%}
        <path d="M4 20l1-4.5L16.5 4l3.5 3.5L8.5 19 4 20Z"/><path d="m14 6.5 3.5 3.5"/>
      {%- when 'search' -%}
        <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
      {%- when 'chat' -%}
        <path d="M4 5h16v11H10l-4.5 4v-4H4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>
      {%- when 'layers' -%}
        <path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12.5 9 5 9-5M3 16.5l9 5 9-5"/>
      {%- when 'globe' -%}
        <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z"/>
      {%- when 'target' -%}
        <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>
      {%- else -%}
        <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
