{%- comment -%} Usage: {% render 'section-head', eyebrow: x, heading: y, text: z %} {%- endcomment -%}
{%- if eyebrow != blank or heading != blank or text != blank -%}
  <div class="section-head reveal">
    {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
    {%- if heading != blank -%}<h2 class="h2">{{ heading | escape }}</h2>{%- endif -%}
    {%- if text != blank -%}<p class="lead">{{ text | escape }}</p>{%- endif -%}
  </div>
{%- endif -%}
