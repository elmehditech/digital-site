<section class="section section--alt" id="{{ section.settings.anchor | default: 'formules' | handleize }}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="packs">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
        <article class="pack reveal{% if block.settings.highlight %} pack--highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="pack__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          <h3 class="pack__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.subtitle != blank -%}<p class="pack__subtitle muted">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
          <p class="pack__price">
            {%- if block.settings.price_prefix != blank -%}<small>{{ block.settings.price_prefix | escape }}</small>{%- endif -%}
            <span>{{ block.settings.price | escape }}</span>
          </p>
          <ul class="pack__features">
            {%- for feature in features -%}
              {%- assign f = feature | strip -%}
              {%- if f != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ f | escape }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if product != blank and product.available -%}
            {%- form 'product', product, class: 'pack__form' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="button {% if block.settings.highlight %}button--primary{% else %}button--ghost{% endif %} button--full">
                {{ block.settings.button_label | escape }}
              </button>
            {%- endform -%}
          {%- else -%}
            <a class="button {% if block.settings.highlight %}button--primary{% else %}button--ghost{% endif %} button--full" href="{{ block.settings.button_url | default: '#devis' }}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="packs__note muted">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Formules et tarifs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #)", "default": "formules" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos formules" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des prix clairs, sans surprise" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "note", "label": "Note sous les formules" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Formule",
      "settings": [
        { "type": "text", "id": "title", "label": "Nom", "default": "Formule" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre" },
        { "type": "text", "id": "price_prefix", "label": "Avant le prix", "info": "Ex. « À partir de »" },
        { "type": "text", "id": "price", "label": "Prix affiché", "default": "699 DH" },
        { "type": "textarea", "id": "features", "label": "Ce qui est inclus", "info": "Un élément par ligne.", "default": "Élément inclus\nÉlément inclus\nÉlément inclus" },
        { "type": "text", "id": "badge", "label": "Étiquette" },
        { "type": "checkbox", "id": "highlight", "label": "Mettre en avant", "default": false },
        { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Commander" },
        { "type": "product", "id": "product", "label": "Produit lié", "info": "Si un produit est choisi, le bouton l'ajoute au panier. Sinon, le bouton ouvre le lien ci-dessous." },
        { "type": "url", "id": "button_url", "label": "Lien du bouton (sans produit)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Formules et tarifs", "blocks": [{ "type": "pack" }, { "type": "pack" }, { "type": "pack" }] }
  ]
}
{% endschema %}
