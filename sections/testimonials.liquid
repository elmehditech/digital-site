<section class="section">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.placeholder -%}<span class="tag tag--static">{{ 'testimonials.placeholder' | t }}</span>{%- endif -%}
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.author | escape }}</strong>
            {%- if block.settings.role != blank -%}<span class="muted">{{ block.settings.role | escape }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What clients say." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Placeholder testimonial. Replace this text with a real quote from one of your clients." },
        { "type": "text", "id": "author", "label": "Client name", "default": "Client name" },
        { "type": "text", "id": "role", "label": "Role / company", "default": "Role, Company" },
        { "type": "checkbox", "id": "placeholder", "label": "Mark as placeholder", "info": "Turn off once this is a real client testimonial.", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
