<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="container split{% if section.settings.image_first %} split--reverse{% endif %}">
    <div class="split__content reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lead">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--ghost" href="{{ section.settings.button_url | default: '/pages/contact' }}">
          {{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
    <div class="split__media reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '480, 800, 1100, 1400' }}
      {%- else -%}
        <div class="split__art" aria-hidden="true"><span></span><span></span><span></span></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who we are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A web development agency focused on results." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Introduce your agency here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_first", "label": "Show image first on desktop", "default": false },
    { "type": "checkbox", "id": "alt_bg", "label": "Use secondary background", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
