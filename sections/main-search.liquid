<section class="section page-top">
  <div class="container">
    <div class="section-head">
      <h1 class="h1 h1--page">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label for="SearchInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <button type="submit" class="button button--primary">{{ 'search.submit' | t }}</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count == 0 -%}
          <p class="muted center">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- else -%}
          <p class="muted center">{{ 'search.results' | t: terms: search.terms }}</p>
          <div class="grid grid--3">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a class="card reveal" href="{{ item.url }}"><h2 class="h3">{{ item.title | escape }}</h2></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "tag": "div" }
{% endschema %}
