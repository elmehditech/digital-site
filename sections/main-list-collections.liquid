<section class="section page-top">
  <div class="container">
    <div class="section-head"><h1 class="h1 h1--page">{{ page_title | escape }}</h1></div>
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a class="card reveal" href="{{ collection.url }}">
          <h2 class="h3">{{ collection.title | escape }}</h2>
          <p class="muted">{{ collection.products_count }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Liste des collections", "tag": "div" }
{% endschema %}
