<article class="section page-top">
  <div class="container container--narrow">
    <p class="muted">{{ article.published_at | date: '%d/%m/%Y' }} · {{ 'blog.by' | t: author: article.author }}</p>
    <h1 class="h1 h1--page">{{ article.title | escape }}</h1>
    {%- if article.image != blank -%}
      <div class="article__image">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 800px) 760px, 100vw', widths: '700, 1400' }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "tag": "div" }
{% endschema %}
