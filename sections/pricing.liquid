<section class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="plans">
      {%- for block in section.blocks -%}
        {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
        <article class="plan reveal{% if block.settings.featured %} plan--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="plan__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          <h3 class="plan__name">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p class="muted plan__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          <p class="plan__price">
            {%- if block.settings.price_prefix != blank -%}<small>{{ block.settings.price_prefix | escape }}</small>{%- endif -%}
            <span>{{ block.settings.price | escape }}</span>
          </p>
          <ul class="checklist">
            {%- for feature in features -%}
              {%- assign f = feature | strip -%}
              {%- if f != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ f | escape }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.button_label != blank -%}
            <a class="button {% if block.settings.featured %}button--primary{% else %}button--ghost{% endif %} button--full" href="{{ block.settings.button_url | default: '/pages/contact' }}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="plans__note reveal">
        {{ section.settings.note | escape }}
        {%- if section.settings.note_link_label != blank %}
          <a class="text-link" href="{{ section.settings.note_link_url | default: '/pages/contact' }}">{{ section.settings.note_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pricing",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clear packages. No surprises." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note under the packages", "default": "Need something custom?" },
    { "type": "text", "id": "note_link_label", "label": "Note link label", "default": "Request a quote" },
    { "type": "url", "id": "note_link_url", "label": "Note link" },
    { "type": "checkbox", "id": "flush_top", "label": "Reduce top spacing", "default": false }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Package",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Package name" },
        { "type": "textarea", "id": "text", "label": "Short description" },
        { "type": "text", "id": "price_prefix", "label": "Text before price", "info": "E.g. “From”" },
        { "type": "text", "id": "price", "label": "Price", "default": "Price" },
        { "type": "textarea", "id": "features", "label": "What is included", "info": "One item per line.", "default": "Included item\nIncluded item\nIncluded item" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this package", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Project" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Pricing", "blocks": [{ "type": "plan" }, { "type": "plan" }, { "type": "plan" }] }]
}
{% endschema %}
