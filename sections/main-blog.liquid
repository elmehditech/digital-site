<section class="section page-top">
  <div class="container">
    <div class="section-head"><h1 class="h1 h1--page">{{ blog.title | escape }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="grid grid--3">
          {%- for article in blog.articles -%}
            <article class="card reveal">
              <p class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</p>
              <h2 class="h3"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <a class="text-link" href="{{ article.url }}">{{ 'general.read_more' | t }}</a>
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="muted center">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "div" }
{% endschema %}
