<footer class="site-footer">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="site-footer__top">
        <p class="site-footer__headline">{{ section.settings.heading | escape }}</p>
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_url | default: '/pages/contact' }}">
            {{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__name">{{ shop.name }}</p>
        {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>

      <nav aria-label="{{ section.settings.menu_title | escape }}">
        <p class="site-footer__title">{{ section.settings.menu_title | escape }}</p>
        <ul class="site-footer__list">
          {%- if section.settings.menu.links.size > 0 -%}
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}pages/services">{{ 'general.services' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/portfolio">{{ 'general.portfolio' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/about">{{ 'general.about' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/pricing">{{ 'general.pricing' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/contact">{{ 'general.contact' | t }}</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <div>
        <p class="site-footer__title">{{ section.settings.contact_title | escape }}</p>
        <ul class="site-footer__list">
          {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a></li>{%- endif -%}
          {%- if settings.phone != blank -%}<li><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a></li>{%- endif -%}
          {%- if settings.address != blank -%}<li>{{ settings.address | escape }}</li>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram | escape }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook | escape }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
          {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin | escape }}" target="_blank" rel="noopener">LinkedIn</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok | escape }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="muted">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights' | t }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Large headline", "default": "Let's build something remarkable." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Project" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "textarea", "id": "text", "label": "Short description", "default": "Web development agency. Shopify stores, e-commerce and business websites, landing pages, redesigns and ongoing optimization." },
    { "type": "text", "id": "menu_title", "label": "Menu title", "default": "Explore" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
    { "type": "text", "id": "contact_title", "label": "Contact title", "default": "Contact" }
  ]
}
{% endschema %}
