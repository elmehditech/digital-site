<section class="section section--flush-top">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="services">
      {%- for block in section.blocks -%}
        {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
        <article class="service reveal" id="{{ block.settings.title | handleize }}" {{ block.shopify_attributes }}>
          <div class="service__head">
            <span class="service__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h2 class="h2 service__title">{{ block.settings.title | escape }}</h2>
          </div>
          <div class="service__body">
            <p class="lead">{{ block.settings.text | escape }}</p>
            <ul class="checklist">
              {%- for feature in features -%}
                {%- assign f = feature | strip -%}
                {%- if f != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ f | escape }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if block.settings.button_label != blank -%}
              <a class="button button--ghost" href="{{ block.settings.button_url | default: '/pages/contact' }}">
                {{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service details",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Service name" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Describe what this service includes and who it is for." },
        { "type": "textarea", "id": "features", "label": "What is included", "info": "One item per line.", "default": "Included item\nIncluded item\nIncluded item" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Project" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Service details", "blocks": [{ "type": "service" }, { "type": "service" }] }]
}
{% endschema %}
