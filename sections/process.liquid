<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step reveal" {{ block.shopify_attributes }}>
          <span class="step__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3 class="h3">{{ block.settings.title | escape }}</h3>
          <p class="muted">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Process",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we work." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use secondary background", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Describe this step." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Process", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
