<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="container split-layout">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="faq__item reveal" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use secondary background", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
