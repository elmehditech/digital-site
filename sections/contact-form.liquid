{%- assign plans = section.settings.plans | newline_to_br | split: '<br />' -%}
<section class="section section--alt" id="{{ section.settings.anchor | default: 'devis' | handleize }}">
  <div class="container contact">
    <div class="contact__intro reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <ul class="contact__list">
        {%- if settings.whatsapp != blank -%}
          {%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
          <li><span class="muted">WhatsApp</span><a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ settings.whatsapp | escape }}</a></li>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <li><span class="muted">Téléphone</span><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a></li>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <li><span class="muted">E-mail</span><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="contact__form card reveal">
      {%- form 'contact', id: 'DevisForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'contact.error' | t }}</p>
        {%- endif -%}
        <div class="field-row">
          <div class="field">
            <label for="DevisName">{{ 'contact.name' | t }}</label>
            <input id="DevisName" type="text" name="contact[Nom]" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="DevisPhone">{{ 'contact.phone' | t }}</label>
            <input id="DevisPhone" type="tel" name="contact[Téléphone]" autocomplete="tel" required>
          </div>
        </div>
        <div class="field">
          <label for="DevisEmail">{{ 'contact.email' | t }}</label>
          <input id="DevisEmail" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        {%- if plans.size > 0 -%}
          <div class="field">
            <label for="DevisPlan">{{ 'contact.plan' | t }}</label>
            <select id="DevisPlan" name="contact[Formule]">
              {%- for plan in plans -%}
                {%- assign p = plan | strip -%}
                {%- if p != blank -%}<option value="{{ p | escape }}">{{ p | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        <div class="field">
          <label for="DevisMessage">{{ 'contact.message' | t }}</label>
          <textarea id="DevisMessage" name="contact[body]" rows="5" required></textarea>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de devis",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #)", "default": "devis" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Devis gratuit" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parlons de votre projet" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Décrivez-nous votre besoin : nous vous répondons avec une proposition claire et un devis adapté." },
    { "type": "textarea", "id": "plans", "label": "Choix proposés dans « Formule souhaitée »", "info": "Un choix par ligne.", "default": "Landing page professionnelle – 699 DH\nSite vitrine – 1 699 DH\nBoutique Shopify – 2 499 DH\nDéveloppement sur mesure – sur devis\nJe ne sais pas encore" }
  ],
  "presets": [{ "name": "Formulaire de devis" }]
}
{% endschema %}
