{%- assign services = section.settings.services | newline_to_br | split: '<br />' -%}
{%- assign budgets = section.settings.budgets | newline_to_br | split: '<br />' -%}
<section class="section section--flush-top" id="contact-form">
  <div class="container contact">
    <div class="contact__intro reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}

      <ul class="contact__list">
        {%- if settings.email != blank -%}
          <li><span class="muted">{{ 'contact.email' | t }}</span><a href="mailto:{{ settings.email | escape }}">{{ settings.email | escape }}</a></li>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <li><span class="muted">{{ 'contact.phone' | t }}</span><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone | escape }}</a></li>
        {%- endif -%}
        {%- if settings.address != blank -%}
          <li><span class="muted">{{ 'contact.location' | t }}</span><span>{{ settings.address | escape }}</span></li>
        {%- endif -%}
      </ul>

      {%- if settings.whatsapp != blank -%}
        {%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
        <div class="contact__whatsapp">
          {%- if section.settings.whatsapp_text != blank -%}<p class="muted">{{ section.settings.whatsapp_text | escape }}</p>{%- endif -%}
          <a class="button button--ghost" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'whatsapp' %} {{ 'contact.whatsapp' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="contact__form reveal">
      {%- form 'contact', id: 'ProjectForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" data-form-message>{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" role="alert" tabindex="-1" data-form-message>{{ 'contact.error' | t }}</p>
        {%- endif -%}
        <div class="field-row">
          <div class="field">
            <label for="FormName">{{ 'contact.name' | t }} *</label>
            <input id="FormName" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="FormEmail">{{ 'contact.email' | t }} *</label>
            <input id="FormEmail" type="email" name="contact[email]" autocomplete="email" required>
          </div>
        </div>
        <div class="field">
          <label for="FormBusiness">{{ 'contact.business' | t }}</label>
          <input id="FormBusiness" type="text" name="contact[Business name]" autocomplete="organization">
        </div>
        <div class="field-row">
          {%- if services.size > 0 -%}
            <div class="field">
              <label for="FormService">{{ 'contact.service' | t }}</label>
              <select id="FormService" name="contact[Service required]" data-service-select>
                {%- for item in services -%}
                  {%- assign v = item | strip -%}
                  {%- if v != blank -%}<option value="{{ v | escape }}">{{ v | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          {%- if budgets.size > 0 -%}
            <div class="field">
              <label for="FormBudget">{{ 'contact.budget' | t }}</label>
              <select id="FormBudget" name="contact[Budget]">
                {%- for item in budgets -%}
                  {%- assign v = item | strip -%}
                  {%- if v != blank -%}<option value="{{ v | escape }}">{{ v | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>
        <div class="field">
          <label for="FormMessage">{{ 'contact.message' | t }} *</label>
          <textarea id="FormMessage" name="contact[body]" rows="6" required></textarea>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Project inquiry" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your project." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Share a few details and we will reply with next steps and a clear proposal." },
    { "type": "text", "id": "whatsapp_text", "label": "Text above WhatsApp button", "default": "Prefer to chat? Message us directly." },
    { "type": "textarea", "id": "services", "label": "“Service required” options", "info": "One option per line.", "default": "Shopify Store Development\nE-commerce Website Development\nBusiness Website Design\nLanding Page Development\nWebsite Redesign\nWebsite Maintenance & Optimization\nNot sure yet" },
    { "type": "textarea", "id": "budgets", "label": "“Budget” options", "info": "One option per line.", "default": "Under 1 000 DH\n1 000 – 2 500 DH\n2 500 – 5 000 DH\nMore than 5 000 DH\nNot sure yet" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
