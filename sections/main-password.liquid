<section class="section page-top center">
  <div class="container container--narrow">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h1 h1--page">{{ 'password.title' | t }}</h1>
    <p class="lead">
      {%- if shop.password_message != blank -%}{{ shop.password_message | escape }}{%- else -%}{{ 'password.text' | t }}{%- endif -%}
    </p>
    {%- form 'storefront_password', class: 'search-form' -%}
      <label for="Password" class="visually-hidden">{{ 'password.label' | t }}</label>
      <input id="Password" type="password" name="password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password">
      <button type="submit" class="button button--primary">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password", "tag": "div" }
{% endschema %}
