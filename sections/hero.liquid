<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="h1 reveal">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
    </h1>
    {%- if section.settings.text != blank -%}
      <p class="lead hero__text reveal">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="hero__buttons reveal">
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.button_url | default: '#formules' }}">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="button button--ghost" href="{{ section.settings.button2_url | default: '#devis' }}">
          {{ section.settings.button2_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hero__stats reveal">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value | escape }}</strong>
            <span>{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Agence de création de sites web" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un site professionnel qui" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre (mise en valeur)", "default": "fait grandir votre activité." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Landing page, site vitrine, boutique Shopify ou développement sur mesure : nous concevons le site qu'il vous faut, à un prix clair." },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Voir nos formules" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Bouton secondaire", "default": "Demander un devis" },
    { "type": "url", "id": "button2_url", "label": "Lien du bouton secondaire" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "settings": [
        { "type": "text", "id": "value", "label": "Valeur", "default": "699 DH" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "À partir de" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Bannière principale" }]
}
{% endschema %}
