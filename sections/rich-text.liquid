<section class="section">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="h2 reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="rte reveal">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your text here.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
